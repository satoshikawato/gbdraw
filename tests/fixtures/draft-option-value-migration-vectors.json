      "expected": {
        "config": {
          "form": {
            "linear_track_layout": "middle"
          },
          "adv": {
            "label_placement": "auto",
            "multi_record_size_mode": "auto"
          }
        }
      }
    },
    {
      "name": "an unknown Linear track layout is refused",
      "input": {
        "config": {
          "form": {
