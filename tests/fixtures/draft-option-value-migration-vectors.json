          "adv": {
            "label_placement": "inside"
          }
        }
      },
      "error": "Linear label placement must be one of: auto, above_feature."
    },
    {
      "name": "an unknown multi-record size mode is refused",
      "input": {
        "config": {
          "adv": {
            "multi_record_size_mode": "sqrt2"
          }
        }
      },
      "error": "Circular multi-record size mode must be one of: auto, linear, equal."
    },
