        }
      }
    },
    {
      "name": "on_feature becomes above_feature and sqrt becomes auto",
      "input": {
        "config": {
          "adv": {
            "label_placement": "on_feature",
            "multi_record_size_mode": "sqrt",
            "nt": "GC"
          }
        }
