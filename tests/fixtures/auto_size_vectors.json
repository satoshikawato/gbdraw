        "reset": [
          {"setting": "labels.font_size", "explicit": 16, "sourceAuto": 14, "targetAuto": null},
          {"setting": "objects.axis.circular.stroke_width", "explicit": 2, "sourceAuto": 3, "targetAuto": null},
          {"setting": "objects.depth.tick_font_size", "explicit": 6, "sourceAuto": 8, "targetAuto": 7}
        ]
      }
    },
    {
      "name": "C: 200 kb Linear to a 20 kb Linear region; only the class changes",
