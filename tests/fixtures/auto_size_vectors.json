          {"setting": "objects.depth.tick_font_size", "explicit": 5, "sourceAuto": 5, "targetAuto": 7}
        ]
      }
    },
    {
      "name": "Circular crop from a long to a short record: the feature width Auto changes, the GC width Auto does not",
      "source": {"mode": "circular", "recordLengths": [5000000]},
      "target": {"mode": "circular", "recordLengths": [30000]},
