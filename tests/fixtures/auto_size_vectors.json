  "adaptations": [
    {
      "name": "A: 5 Mb Circular to 32 kb Linear; mode and class change",
      "source": {"mode": "circular", "recordLengths": [5000000]},
      "target": {"mode": "linear", "recordLengths": [32000]},
      "explicit": {
        "labels.font_size": 10,
        "objects.features.block_stroke_width": 0.5,
        "objects.axis.circular.stroke_width": 2,
        "objects.legends.font_size": 14,
        "objects.gc_content.tick_font_size": 7,
        "window": 5000,
        "step": 500,
        "objects.scale.interval": 1000000,
        "objects.depth.max_depth": 500
      },
      "expected": {
        "kept": {"objects.gc_content.tick_font_size": 7},
        "reset": [
          {"setting": "labels.font_size", "explicit": 10, "sourceAuto": 8, "targetAuto": null},
          {"setting": "objects.features.block_stroke_width", "explicit": 0.5, "sourceAuto": 0, "targetAuto": 2},
          {"setting": "objects.axis.circular.stroke_width", "explicit": 2, "sourceAuto": 1, "targetAuto": null},
          {"setting": "objects.legends.font_size", "explicit": 14, "sourceAuto": 16, "targetAuto": 20},
          {"setting": "window", "explicit": 5000, "sourceAuto": 10000, "targetAuto": 1000},
          {"setting": "step", "explicit": 500, "sourceAuto": 1000, "targetAuto": 100},
          {"setting": "objects.scale.interval", "explicit": 1000000, "sourceAuto": 500000, "targetAuto": 5000}
        ]
      }
    },
    {
