  {
   "id": "integral-fraction-at-an-integer",
   "note": "JSON.parse reads 1.0 as the integer 1; Python's json reads a float.",
   "shape": {
    "kind": "integer"
   },
   "text": "1.0",
   "python": [
    {
     "path": "value",
     "reason": "non-integer"
    }
   ],
   "web": []
  },
  {
   "id": "integer-above-2^53-at-an-integer",
   "note": "Both accept it; JSON.parse rounds it to 9007199254740992.",
   "shape": {
    "kind": "integer"
   },
   "text": "9007199254740993",
   "python": [],
   "web": []
  },
  {
   "id": "integer-above-2^53-at-a-literal",
   "note": "JSON.parse rounds the value to the literal; Python compares the exact integer.",
   "shape": {
    "kind": "literal",
    "values": [
     9007199254740992
    ]
   },
   "text": "9007199254740993",
   "python": [
    {
     "path": "value",
     "reason": "not-in-set"
    }
   ],
   "web": []
  },
  {
   "id": "proto-as-an-own-key",
   "note": "JSON.parse makes __proto__ an own key, so both report it; a reader must not copy it with assignment.",
   "shape": {
    "kind": "object",
    "fields": {},
    "optional": [],
    "open": false
   },
   "text": "{\"__proto__\": 1}",
   "python": [
    {
     "path": "value.__proto__",
     "reason": "unknown-key"
    }
   ],
   "web": [
    {
     "path": "value.__proto__",
     "reason": "unknown-key"
    }
   ]
  },
  {
   "id": "integer-like-keys-come-first",
   "note": "A JavaScript object lists integer-like keys first, in ascending order; Python keeps the text's order.",
   "shape": {
    "kind": "object",
    "fields": {},
    "optional": [],
    "open": false
   },
   "text": "{\"b\": 1, \"1\": 2}",
   "python": [
    {
     "path": "value.b",
     "reason": "unknown-key"
    },
    {
     "path": "value.1",
     "reason": "unknown-key"
    }
   ],
   "web": [
    {
     "path": "value.1",
     "reason": "unknown-key"
    },
    {
     "path": "value.b",
     "reason": "unknown-key"
    }
   ]
  }
 ]
