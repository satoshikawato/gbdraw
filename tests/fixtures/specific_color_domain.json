{
  "description": "Specific-color table color domain shared by the Web parser and the Python table reader. The browser resolves a color name to hex and rejects unknown names; DOM-free JavaScript leaves a single-word name ('word') for Python to validate.",
  "valid": [
    { "value": "none", "normalized": "none" },
    { "value": "NONE", "normalized": "none" },
    { "value": "None", "normalized": "none" },
    { "value": "#abc", "normalized": "#abc" },
    { "value": "#A1B2C3", "normalized": "#a1b2c3" },
    { "value": "red", "word": true, "browser": "#ff0000" },
    { "value": "Grey", "word": true, "browser": "#808080" }
  ],
  "invalid": [
    { "value": "notacolor", "word": true },
    { "value": "transparent", "word": true },
    { "value": "#f008" },
    { "value": "#ff000080" },
    { "value": "#abcd" },
    { "value": "#12" },
    { "value": "rgb(1,2,3)" },
    { "value": "light green" }
  ]
}
