    { "value": "none", "normalized": "none" },
    { "value": "NONE", "normalized": "none" },
    { "value": "None", "normalized": "none" },
    { "value": "#abc", "normalized": "#abc" },
    { "value": "#A1B2C3", "normalized": "#a1b2c3" },
    { "value": "red", "normalized": "#ff0000" },
    { "value": "Grey", "normalized": "#808080" },
    { "value": "DarkGrey", "normalized": "#a9a9a9" }
  ],
  "invalid": [
    { "value": "notacolor" },
    { "value": "transparent" },
    { "value": "currentColor" },
    { "value": "ButtonFace" },
    { "value": "Canvas" },
    { "value": "#f008" },
    { "value": "#ff000080" },
    { "value": "#abcd" },
    { "value": "#12" },
    { "value": "rgb(1,2,3)" },
    { "value": "light green" }
  ]
}
