    {
      "name": "Prokka-style empty ACCESSION and VERSION lines",
      "format": "genbank",
      "files": {
        "source": {
          "name": "prokka.gbk",
          "lines": [
            "LOCUS       contig_1                 60 bp    DNA     linear       30-SEP-2026",
            "DEFINITION  synthetic record.",
            "ACCESSION   ",
            "VERSION",
            "KEYWORDS    .",
            "SOURCE      .",
            "  ORGANISM  Escherichia coli",
            "            Unclassified.",
            "FEATURES             Location/Qualifiers",
            "     source          1..60",
            "                     /organism=\"Escherichia coli\"",
            "ORIGIN",
            "        1 acgtacgtac gtacgtacgt acgtacgtac gtacgtacgt acgtacgtac gtacgtacgt",
            "//"
          ]
        }
      },
      "expected": {
        "records": [
          {
            "recordId": "contig_1",
            "recordLength": 60,
            "organism": "Escherichia coli",
            "inferredDefinition": "<i>Escherichia coli</i>"
          }
        ]
      },
      "knownDefect": "IN-02"
