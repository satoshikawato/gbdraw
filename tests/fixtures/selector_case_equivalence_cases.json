      "record_id": "CASE1",
      "priority": ["gene", "product"],
      "features": [
        { "svg_id": "case-a", "type": "CDS", "start": 100, "end": 700, "strand": 1, "qualifiers": { "gene": ["orfA"], "product": ["alpha protein"] } },
        { "svg_id": "case-b", "type": "CDS", "start": 1500, "end": 2100, "strand": -1, "qualifiers": { "gene": ["ORFA"], "product": ["beta protein"] } }
      ],
      "target": "case-a",
      "expected": { "qualifier": "product", "value": "alpha protein" },
      "rejected": [{ "qualifier": "gene", "value": "orfA" }]
    },
    {
      "id": "locus-tag-differs-only-in-case",
