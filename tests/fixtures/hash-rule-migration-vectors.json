  "selectorCases": [
    {
      "name": "A bare drawn hash names its feature's source hash",
      "value": "fd1d1d1d1",
      "expected": {
        "value": "f51515151",
        "sourceCount": 1
      }
    },
    {
      "name": "An anchored value keeps its anchors, and case is ignored",
      "value": "^FD1D1D1D1$",
      "expected": {
        "value": "^f51515151$",
        "sourceCount": 1
      }
    },
    {
      "name": "A rendered ID names the drawn features of its record (release 0.13.0)",
      "value": "fd5d5d5d5_record_2",
      "expected": {
        "value": "f55555555",
        "sourceCount": 1
      }
    },
    {
      "name": "A rendered ID of another record names none of them",
      "value": "fd5d5d5d5_record_1",
      "expected": {
        "value": null,
        "sourceCount": 0
      }
    },
    {
      "name": "An instance suffix names the drawn feature with that source index",
      "value": "fd3d3d3d3__instance_2_25cba05a594010cc",
      "expected": {
        "value": "f53535353",
        "sourceCount": 1
      }
    },
    {
      "name": "Instances of one source hash name it once",
      "value": "fd3d3d3d3",
      "expected": {
        "value": "f53535353",
        "sourceCount": 1
      }
    },
    {
      "name": "A hash drawn by features of two source hashes names none",
      "value": "f6d6d6d6d",
      "expected": {
        "value": null,
        "sourceCount": 2
      }
    },
    {
      "name": "A value whose features keep their hash stays as saved",
      "value": "fa1a1a1a1",
      "expected": {
        "value": null,
        "sourceCount": 1
      }
    },
    {
      "name": "An instance suffix of a record drawn untransformed stays as saved",
      "value": "fa1a1a1a1__instance_record_1_25cba05a594010cc",
      "expected": {
        "value": null,
        "sourceCount": 1
      }
    },
    {
      "name": "A Linear record suffix, which no matcher reads, is removed (OV-416)",
      "value": "fa1a1a1a1_record_1",
      "expected": {
        "value": "fa1a1a1a1",
        "sourceCount": 1
      }
    },
    {
      "name": "A source hash names no drawn feature",
      "value": "f51515151",
      "expected": {
        "value": null,
        "sourceCount": 0
      }
    }
