      "feature": "cds_fl1",
      "visibilityRules": [
        {
          "recordId": "*",
          "featureType": "CDS",
          "qualifier": "locus_tag",
          "value": "(?P<tag>FL1)\\Z",
          "action": "off"
        }
      ],
      "selectedFeatures": [
        "CDS"
      ],
      "drawn": false
    },
    {
      "name": "a regex folds letter case as Python does",
      "feature": "cds_fl2",
      "visibilityRules": [
        {
          "recordId": "*",
          "featureType": "CDS",
          "qualifier": "product",
          "value": "^i-protein$",
          "action": "off"
        }
