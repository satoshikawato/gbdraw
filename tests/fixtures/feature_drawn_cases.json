          "recordId": "*",
          "featureType": "CDS",
          "qualifier": "locus_tag",
          "value": "FL1",
          "action": "exclude_matching"
        },
        {
          "recordId": "*",
          "featureType": "CDS",
          "qualifier": "locus_tag",
          "value": "FL1",
          "action": "off"
        }
      ],
      "selectedFeatures": [
        "CDS"
      ],
      "drawn": true
    },
    {
