        {"id": "one_color", "renderer": "dinucleotide_skew", "enabled": true, "params": {"nt": "AT", "positive_color": "#123456", "negative_color": "#123456"}}
      ],
      "rows": [
        ["AT content", "gc_content", "at_content", "#a0a0a0"],
