#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

ZERO_SHA="0000000000000000000000000000000000000000"
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

saw_ref=0
while read -r local_ref local_sha remote_ref remote_sha; do
  saw_ref=1
  if [[ "$local_sha" == "$ZERO_SHA" ]]; then
    continue
  fi
  if [[ "$remote_sha" == "$ZERO_SHA" ]]; then
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-parse "$local_sha^")"
  else
    base="$remote_sha"
  fi
  git diff --name-only "$base" "$local_sha" >>"$TMP"
done

if [[ "$saw_ref" -eq 0 ]]; then
  base="$(git merge-base HEAD origin/main 2>/dev/null || git rev-parse HEAD^)"
  git diff --name-only "$base" HEAD >>"$TMP"
fi

sort -u -o "$TMP" "$TMP"

if ! grep -Eq \
  '^(gbdraw/web/js/|tests/web/|AGENTS\.md$|CLAUDE\.md$|gbdraw/web/CLAUDE\.md$|\.agents/skills/refactor-gbdraw-web-safely/|package\.json$|package-lock\.json$|\.github/workflows/web-refactor-guardrails\.yml$)' \
  "$TMP"; then
  exit 0
fi

echo "Running gbdraw Web refactor guardrails before push..."
npm run test:web:refactor-guards
